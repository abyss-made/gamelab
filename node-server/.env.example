# Copy to .env (never commit .env). The server reads these from the shell
# environment; it does not load .env files by itself.
SITE_NAME=
PORT=
# Private-alpha gate (off by default). If ALPHA_ENABLED=true, ALPHA_SECRET is
# required (16+ characters) or the server refuses to start. Set it only in the
# host's environment settings, never in a committed file.
ALPHA_ENABLED=
ALPHA_SECRET=
# Optional. Comma-separated game ids hidden from every picker. Leave it commented
# out for the default below; HIDDEN_GAMES= (empty) shows all 25 games.
# HIDDEN_GAMES=higherlower,liarsdice,hotpotato,reversi
